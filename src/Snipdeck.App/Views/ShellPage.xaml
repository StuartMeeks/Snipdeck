<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Snipdeck.App.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Snipdeck.App.Controls"
    xmlns:converters="using:Snipdeck.App.Converters"
    xmlns:local="using:Snipdeck.App.Views"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:Snipdeck.Core.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Name="ShellRoot">

    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Theme-specific hero image: drop HomeHeroLight.png / HomeHeroDark.png
                 into Assets and the header swaps them with the selected theme. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <BitmapImage x:Key="HomeHeroImage" UriSource="ms-appx:///Assets/HomeHeroLight.png" />
                    <!-- Fades from the page background at 0 alpha to opaque, so the
                         hero blends into the background with no white haze (a plain
                         "Transparent" stop is transparent *white*, which is the bug). -->
                    <LinearGradientBrush x:Key="HomeHeroFadeBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00F3F3F3" Offset="0" />
                        <GradientStop Color="#00F3F3F3" Offset="0.5" />
                        <GradientStop Color="#FFF3F3F3" Offset="1" />
                    </LinearGradientBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <BitmapImage x:Key="HomeHeroImage" UriSource="ms-appx:///Assets/HomeHeroDark.png" />
                    <LinearGradientBrush x:Key="HomeHeroFadeBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00202020" Offset="0" />
                        <GradientStop Color="#00202020" Offset="0.5" />
                        <GradientStop Color="#FF202020" Offset="1" />
                    </LinearGradientBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <BitmapImage x:Key="HomeHeroImage" UriSource="ms-appx:///Assets/HomeHeroDark.png" />
                    <LinearGradientBrush x:Key="HomeHeroFadeBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00202020" Offset="0" />
                        <GradientStop Color="#00202020" Offset="0.5" />
                        <GradientStop Color="#FF202020" Offset="1" />
                    </LinearGradientBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:BoolToVisibilityConverter x:Key="InvertedBoolToVisibility" Invert="True" />
        <converters:CountToVisibilityConverter x:Key="CountToVisibility" />
        <converters:CountToVisibilityConverter x:Key="InvertedCountToVisibility" Invert="True" />
        <converters:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibility" />

        <DataTemplate x:Key="HomeContentTemplate" x:DataType="vm:HomeViewModel">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <!-- No outer padding: the hero header is full-bleed. -->
                <StackPanel Spacing="0">

                    <!-- Hero header (WinUI Gallery layout): a FIXED-height hero whose
                         image is painted by a Composition mask brush so its lower
                         edge fades to transparent, revealing the page's Mica behind
                         it. The title sits top-left; the CLI carousel below is pulled
                         up so the cards straddle the hero's bottom edge. -->
                    <Grid Height="360">
                        <!-- Composition-masked hero image is set as this Border's
                             child visual in code-behind (theme-aware, size-tracked). -->
                        <Border x:Name="HeroHost"
                                IsHitTestVisible="False"
                                Loaded="OnHeroHostLoaded"
                                SizeChanged="OnHeroHostSizeChanged" />

                        <StackPanel VerticalAlignment="Top" Margin="36,32,36,0" Spacing="4">
                            <TextBlock Text="Next Iteration"
                                       FontSize="18"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="Snipdeck"
                                       Style="{ThemeResource TitleLargeTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <!-- CLI launcher: pulled up by 75% of a card's height so the cards
                         straddle the hero's bottom edge — ~75% over the hero, ~25%
                         spilling onto the page below. (Card height 172 → -129.) -->
                    <ScrollViewer Margin="0,-129,0,0"
                                  Padding="36,0,36,0"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollMode="Enabled">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ItemsControl ItemsSource="{x:Bind CliCards}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="12" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CliCardViewModel">
                                        <controls:CliCard
                                            ViewModel="{x:Bind}"
                                            NavigateCommand="{Binding ElementName=ShellRoot, Path=ViewModel.SelectCliCommand}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- New CLI tile at the end of the carousel (always present). -->
                            <Button Click="OnNewCliClicked"
                                    Width="232"
                                    Height="172"
                                    Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                    <FontIcon Glyph="&#xE710;" FontSize="24" HorizontalAlignment="Center" />
                                    <TextBlock Text="New CLI" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Snip categories: Most used / Recent / Favourites (unscoped). -->
                    <StackPanel Padding="24" Spacing="16" Margin="0,8,0,0"
                                Visibility="{x:Bind HasCliCards, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <ToggleButton CornerRadius="16"
                                          IsChecked="{x:Bind IsMostUsedSelected, Mode=OneWay}"
                                          Command="{x:Bind SelectMostUsedCommand}"
                                          Click="OnHomeCategoryToggled">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE9D9;" FontSize="14" />
                                    <TextBlock Text="Most used" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton CornerRadius="16"
                                          IsChecked="{x:Bind IsRecentSelected, Mode=OneWay}"
                                          Command="{x:Bind SelectRecentCommand}"
                                          Click="OnHomeCategoryToggled">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE823;" FontSize="14" />
                                    <TextBlock Text="Recent" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton CornerRadius="16"
                                          IsChecked="{x:Bind IsFavouritesSelected, Mode=OneWay}"
                                          Command="{x:Bind SelectFavouritesCommand}"
                                          Click="OnHomeCategoryToggled">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE735;" FontSize="14" />
                                    <TextBlock Text="Favourites" />
                                </StackPanel>
                            </ToggleButton>
                        </StackPanel>

                        <GridView ItemsSource="{x:Bind ActiveSnips, Mode=OneWay}"
                                  SelectionMode="None"
                                  IsItemClickEnabled="False"
                                  HorizontalAlignment="Left">
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="vm:SnipCardViewModel">
                                    <controls:SnipCard
                                        Width="320"
                                        Margin="0,0,12,12"
                                        ViewModel="{x:Bind}"
                                        CopyCommand="{Binding ElementName=ShellRoot, Path=ViewModel.CopySnipCommand}"
                                        EditCommand="{Binding ElementName=ShellRoot, Path=ViewModel.EditSnipCommand}"
                                        DeleteCommand="{Binding ElementName=ShellRoot, Path=ViewModel.DeleteSnipCommand}"
                                        FavouriteCommand="{Binding ElementName=ShellRoot, Path=ViewModel.ToggleFavouriteCommand}" />
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>

                        <TextBlock Text="Nothing here yet."
                                   Style="{ThemeResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Visibility="{x:Bind HasActiveSnips, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibility}}" />
                    </StackPanel>

                    <StackPanel Padding="24" Spacing="8"
                                HorizontalAlignment="Center"
                                Margin="0,24,0,0"
                                Visibility="{x:Bind HasCliCards, Converter={StaticResource InvertedBoolToVisibility}}">
                        <TextBlock Text="Welcome to Snipdeck"
                                   Style="{ThemeResource TitleTextBlockStyle}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Use the New CLI tile above to get started."
                                   Style="{ThemeResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <DataTemplate x:Key="CliContentTemplate" x:DataType="vm:CliViewModel">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="24" Spacing="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{x:Bind Name}"
                                   Style="{ThemeResource TitleTextBlockStyle}"
                                   VerticalAlignment="Center" />
                        <!-- CLI-specific actions: hidden in the synthetic "All" scope,
                             where there is no single CLI to edit/delete or add a snip to. -->
                        <Button Grid.Column="1"
                                Margin="0,0,8,0"
                                Content="Shared parameters"
                                Visibility="{x:Bind HasCli, Converter={StaticResource BoolToVisibility}}"
                                Command="{Binding ElementName=ShellRoot, Path=ViewModel.OpenCliParametersCommand}" />
                        <Button Grid.Column="2"
                                Margin="0,0,8,0"
                                Content="Edit CLI"
                                Visibility="{x:Bind HasCli, Converter={StaticResource BoolToVisibility}}"
                                Click="OnEditCliClicked" />
                        <Button Grid.Column="3"
                                Margin="0,0,8,0"
                                Content="Delete CLI"
                                Style="{StaticResource DangerButtonStyle}"
                                Visibility="{x:Bind HasCli, Converter={StaticResource BoolToVisibility}}"
                                Click="OnDeleteCliClicked" />
                        <Button Grid.Column="4"
                                Content="New snip"
                                Style="{ThemeResource AccentButtonStyle}"
                                Visibility="{x:Bind HasCli, Converter={StaticResource BoolToVisibility}}"
                                Click="OnNewSnipClicked" />
                    </Grid>

                    <TextBlock Text="No snips match the current filter."
                               Style="{ThemeResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="{x:Bind IsEmpty, Converter={StaticResource BoolToVisibility}}" />

                    <ItemsControl ItemsSource="{x:Bind Snips}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SnipCardViewModel">
                                <controls:SnipCard
                                    ViewModel="{x:Bind}"
                                    CopyCommand="{Binding ElementName=ShellRoot, Path=ViewModel.CopySnipCommand}"
                                    EditCommand="{Binding ElementName=ShellRoot, Path=ViewModel.EditSnipCommand}"
                                    DeleteCommand="{Binding ElementName=ShellRoot, Path=ViewModel.DeleteSnipCommand}"
                                    FavouriteCommand="{Binding ElementName=ShellRoot, Path=ViewModel.ToggleFavouriteCommand}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <DataTemplate x:Key="SettingsContentTemplate" x:DataType="vm:SettingsViewModel">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="24" Spacing="8" MaxWidth="720" HorizontalAlignment="Stretch">
                    <TextBlock Text="Settings"
                               Style="{ThemeResource TitleTextBlockStyle}"
                               Margin="0,0,0,8" />

                    <TextBlock Text="Appearance &amp; behaviour"
                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                               Margin="0,4,0,4" />

                    <tk:SettingsCard Header="Theme"
                                     Description="Applies immediately. System follows your Windows preference.">
                        <ComboBox SelectedIndex="{x:Bind ThemeIndex, Mode=TwoWay}" MinWidth="160">
                            <x:String>System</x:String>
                            <x:String>Light</x:String>
                            <x:String>Dark</x:String>
                        </ComboBox>
                    </tk:SettingsCard>

                    <tk:SettingsCard Header="Close behaviour"
                                     Description="Hide-to-tray keeps the hotkey live. Exit closes the process.">
                        <ComboBox SelectedIndex="{x:Bind CloseBehaviourIndex, Mode=TwoWay}" MinWidth="200">
                            <x:String>Hide to tray</x:String>
                            <x:String>Exit on close</x:String>
                        </ComboBox>
                    </tk:SettingsCard>

                    <tk:SettingsCard Header="Global hotkey"
                                     Description="Click, then press a shortcut (needs Ctrl, Alt or Shift). Summons Snipdeck from anywhere.">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind HotkeyError, Mode=OneWay}"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="200"
                                       Visibility="{x:Bind HotkeyError, Mode=OneWay, Converter={StaticResource EmptyStringToVisibility}}" />
                            <controls:HotkeyCaptureBox
                                CurrentText="{x:Bind HotkeyDisplay, Mode=OneWay}"
                                Command="{x:Bind RebindHotkeyCommand}" />
                            <Button Content="Reset"
                                    Command="{x:Bind ResetHotkeyCommand}"
                                    ToolTipService.ToolTip="Reset to Ctrl+Alt+S" />
                        </StackPanel>
                    </tk:SettingsCard>

                    <tk:SettingsCard Header="Storage location"
                                     Description="Where your snips live. Changing it restarts Snipdeck to load the new location.">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind StorageDirectory, Mode=OneWay}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="260" />
                            <Button Content="Change…"
                                    Command="{x:Bind ChangeStoragePathCommand}" />
                        </StackPanel>
                    </tk:SettingsCard>

                    <tk:SettingsCard Header="Backups to keep"
                                     Description="Older backups beyond this count are pruned after each save.">
                        <NumberBox Value="{x:Bind BackupRetention, Mode=TwoWay}"
                                   Minimum="1"
                                   Maximum="200"
                                   SmallChange="1"
                                   SpinButtonPlacementMode="Inline"
                                   MinWidth="120" />
                    </tk:SettingsCard>

                    <TextBlock Text="About"
                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                               Margin="0,16,0,4" />

                    <tk:SettingsCard Header="Updates"
                                     Description="Check the GitHub releases feed for a newer build.">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind UpdateStatusMessage, Mode=OneWay}"
                                       VerticalAlignment="Center"
                                       Style="{ThemeResource CaptionTextBlockStyle}" />
                            <Button Content="Check for updates"
                                    Command="{x:Bind CheckForUpdatesCommand}" />
                            <Button Content="Apply &amp; restart"
                                    Command="{x:Bind ApplyUpdateCommand}"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Visibility="{x:Bind UpdateAvailable, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </tk:SettingsCard>

                    <tk:SettingsExpander Header="Snipdeck"
                                         Description="{x:Bind CopyrightDisplay}">
                        <!-- Collapsed: version shows on the right of the header. -->
                        <TextBlock Text="{x:Bind VersionDisplay}"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <tk:SettingsExpander.Items>
                            <tk:SettingsCard Header="To clone this repository">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="git clone https://github.com/StuartMeeks/Snipdeck"
                                               FontFamily="Cascadia Mono, Consolas, Courier New"
                                               VerticalAlignment="Center"
                                               IsTextSelectionEnabled="True" />
                                    <Button Click="OnCopyCloneCommandClicked"
                                            ToolTipService.ToolTip="Copy to clipboard">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                    </Button>
                                </StackPanel>
                            </tk:SettingsCard>
                            <tk:SettingsCard Header="File a bug or request a new feature">
                                <HyperlinkButton Content="Open issues on GitHub"
                                                 NavigateUri="https://github.com/StuartMeeks/Snipdeck/issues" />
                            </tk:SettingsCard>
                        </tk:SettingsExpander.Items>
                    </tk:SettingsExpander>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <DataTemplate x:Key="TrashContentTemplate" x:DataType="vm:TrashViewModel">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="24" Spacing="16" MaxWidth="720" HorizontalAlignment="Stretch">
                    <TextBlock Text="Trash"
                               Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock Text="Deleted snips are kept here. Restore a snip to put it back in its CLI, or delete it permanently."
                               Style="{ThemeResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />

                    <TextBlock Text="Trash is empty."
                               Style="{ThemeResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="{x:Bind IsEmpty, Converter={StaticResource BoolToVisibility}}" />

                    <ItemsControl ItemsSource="{x:Bind Snips}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SnipCardViewModel">
                                <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                      BorderThickness="1"
                                      CornerRadius="8"
                                      Padding="16">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Text="{x:Bind Title}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                                               TextTrimming="CharacterEllipsis" />

                                    <Border Grid.Row="1"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="4"
                                            Padding="8,6"
                                            Margin="0,8,0,0">
                                        <TextBlock Text="{x:Bind CommandTemplate}"
                                                   FontFamily="Cascadia Mono, Consolas, Courier New"
                                                   FontSize="12"
                                                   TextWrapping="Wrap" />
                                    </Border>

                                    <StackPanel Grid.Row="2"
                                                Orientation="Horizontal"
                                                Spacing="8"
                                                Margin="0,12,0,0">
                                        <Button Content="Restore"
                                                Style="{ThemeResource AccentButtonStyle}"
                                                Command="{Binding ElementName=ShellRoot, Path=ViewModel.RestoreSnipCommand}"
                                                CommandParameter="{x:Bind}" />
                                        <Button Content="Delete permanently"
                                                Command="{Binding ElementName=ShellRoot, Path=ViewModel.DeleteForeverCommand}"
                                                CommandParameter="{x:Bind}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <DataTemplate x:Key="SharedParametersContentTemplate" x:DataType="vm:SharedParametersViewModel">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="24" Spacing="16" MaxWidth="720" HorizontalAlignment="Stretch">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Title}"
                                       Style="{ThemeResource TitleTextBlockStyle}" />
                            <TextBlock Text="{x:Bind Description}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="Add parameter"
                                Style="{ThemeResource AccentButtonStyle}"
                                VerticalAlignment="Top"
                                Command="{Binding ElementName=ShellRoot, Path=ViewModel.AddSharedParameterCommand}" />
                    </Grid>

                    <TextBlock Text="No shared parameters yet. Click Add parameter to define one."
                               Style="{ThemeResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="{x:Bind IsEmpty, Converter={StaticResource BoolToVisibility}}" />

                    <ItemsControl ItemsSource="{x:Bind Parameters}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ParameterDisplayViewModel">
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="6">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{x:Bind Name}"
                                                           Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Border Grid.Column="1"
                                                        Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                                        CornerRadius="10"
                                                        Padding="8,2"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind TypeDisplay}"
                                                               Style="{ThemeResource CaptionTextBlockStyle}" />
                                                </Border>
                                            </Grid>
                                            <TextBlock Style="{ThemeResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Visibility="{x:Bind HasDefault, Converter={StaticResource BoolToVisibility}}">
                                                <Run Text="Default:" />
                                                <Run Text="{x:Bind Default}" />
                                            </TextBlock>
                                            <TextBlock Style="{ThemeResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextWrapping="Wrap"
                                                       Visibility="{x:Bind HasOptions, Converter={StaticResource BoolToVisibility}}">
                                                <Run Text="Options:" />
                                                <Run Text="{x:Bind OptionsDisplay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    Spacing="8"
                                                    VerticalAlignment="Top">
                                            <Button Content="Edit"
                                                    Command="{Binding ElementName=ShellRoot, Path=ViewModel.EditSharedParameterCommand}"
                                                    CommandParameter="{x:Bind}" />
                                            <Button Style="{StaticResource DangerButtonStyle}"
                                                    ToolTipService.ToolTip="Delete parameter"
                                                    Command="{Binding ElementName=ShellRoot, Path=ViewModel.DeleteSharedParameterCommand}"
                                                    CommandParameter="{x:Bind}">
                                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <DataTemplate x:Key="TagIconsContentTemplate" x:DataType="vm:TagIconsViewModel">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="24" Spacing="16" MaxWidth="720" HorizontalAlignment="Stretch">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Tags"
                                       Style="{ThemeResource TitleTextBlockStyle}" />
                            <TextBlock Text="Give a tag an icon (a Segoe Fluent Icons glyph, e.g. paste a character or enter its code). Shown beside the tag in the left navigation; blank uses the default tag icon."
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="Save"
                                Style="{ThemeResource AccentButtonStyle}"
                                Command="{Binding ElementName=ShellRoot, Path=ViewModel.SaveTagIconsCommand}" />
                    </Grid>

                    <TextBlock Text="{x:Bind StatusMessage, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="{x:Bind StatusMessage, Mode=OneWay, Converter={StaticResource EmptyStringToVisibility}}" />

                    <TextBlock Text="No tags yet. Add tags to your snips, then give them icons here."
                               Style="{ThemeResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="{x:Bind IsEmpty, Converter={StaticResource BoolToVisibility}}" />

                    <ItemsControl ItemsSource="{x:Bind Rows}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TagIconRowViewModel">
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="6"
                                        Padding="12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="160" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0"
                                                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                  Glyph="{x:Bind PreviewGlyph, Mode=OneWay}"
                                                  FontSize="18"
                                                  VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind TagName}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBox Grid.Column="2"
                                                 PlaceholderText="Icon (blank = default)"
                                                 Text="{x:Bind Glyph, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <local:ShellContentTemplateSelector x:Key="ShellContentSelector"
                                             HomeTemplate="{StaticResource HomeContentTemplate}"
                                             CliTemplate="{StaticResource CliContentTemplate}"
                                             SettingsTemplate="{StaticResource SettingsContentTemplate}"
                                             TrashTemplate="{StaticResource TrashContentTemplate}"
                                             SharedParametersTemplate="{StaticResource SharedParametersContentTemplate}"
                                             TagIconsTemplate="{StaticResource TagIconsContentTemplate}" />
        </ResourceDictionary>
    </UserControl.Resources>

    <NavigationView x:Name="ShellNavigation"
                    IsBackButtonVisible="Collapsed"
                    IsPaneToggleButtonVisible="False"
                    IsSettingsVisible="False"
                    PaneDisplayMode="Left"
                    OpenPaneLength="280"
                    ItemInvoked="OnNavigationItemInvoked">

        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="HomeNavItem" Content="Home">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE80F;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="DocumentationNavItem"
                                Content="Documentation"
                                SelectsOnInvoked="False">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8A5;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItemHeader Content="Tags" />
        </NavigationView.MenuItems>

        <NavigationView.FooterMenuItems>
            <!-- Footer destinations as nav items, so they get the selected look
                 (indicator bar + darker background) like Home and the tags. -->
            <NavigationViewItem x:Name="SharedParametersNavItem" Content="Shared parameters">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE943;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="TagsNavItem" Content="Tags">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8EC;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="TrashNavItem" Content="Trash">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE74D;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="SettingsNavItem" Content="Settings">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE713;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>

        <ContentControl Content="{x:Bind ViewModel.CurrentContent, Mode=OneWay}"
                        ContentTemplateSelector="{StaticResource ShellContentSelector}"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />
    </NavigationView>
</UserControl>
