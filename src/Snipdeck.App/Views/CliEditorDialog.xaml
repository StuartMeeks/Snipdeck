<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Snipdeck.App.Views.CliEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Snipdeck.Core.ViewModels"
    xmlns:converters="using:Snipdeck.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Edit CLI"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <ContentDialog.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </ContentDialog.Resources>

    <!-- Right padding leaves a gutter for the overlay scrollbar. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="560" Padding="0,0,12,0">
        <StackPanel MinWidth="400" Spacing="12">
            <TextBox Header="Name"
                     Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <TextBox Header="Description"
                     PlaceholderText="A short summary, shown on the CLI's Home card"
                     Text="{x:Bind ViewModel.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Height="64" />

            <StackPanel Spacing="6">
                <TextBlock Text="Icon"
                           Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="Defaults to a deterministic identicon. Upload an image to override; it'll be cropped square and resized to 256×256."
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{x:Bind ViewModel.PickedIconFileName, Mode=OneWay}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="1"
                            Content="Choose image..."
                            Click="OnPickIconClicked" />
                </Grid>
            </StackPanel>

            <!-- Execution: where and how this CLI's snips run. All optional — Snipdeck
                 stays useful for authoring snips for a tool that isn't installed yet,
                 so these are validated only at Run time, never on save. -->
            <StackPanel Spacing="6">
                <TextBlock Text="Execution"
                           Style="{ThemeResource BodyStrongTextBlockStyle}" />

                <ComboBox Header="Shell"
                          HorizontalAlignment="Stretch"
                          SelectedIndex="{x:Bind ViewModel.ShellIndex, Mode=TwoWay}">
                    <x:String>Command Prompt (cmd)</x:String>
                    <x:String>Windows PowerShell</x:String>
                    <x:String>PowerShell (pwsh)</x:String>
                    <x:String>Bash</x:String>
                    <x:String>Custom…</x:String>
                </ComboBox>

                <StackPanel Spacing="6"
                            Visibility="{x:Bind ViewModel.IsCustomShell, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBox Header="Custom shell path"
                             PlaceholderText="e.g. C:\tools\nu.exe"
                             Text="{x:Bind ViewModel.CustomShellPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Header="Custom shell arguments"
                             PlaceholderText="Use {command} where the resolved command goes, e.g. -c {command}"
                             Text="{x:Bind ViewModel.CustomShellArgsTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <TextBlock Text="Executable path"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Margin="0,4,0,0" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             PlaceholderText="Optional — validated only when you Run a snip"
                             Text="{x:Bind ViewModel.ExecutablePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1"
                            Content="Browse…"
                            Click="OnBrowseExecutableClicked" />
                </Grid>

                <TextBlock Text="Working directory"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Margin="0,4,0,0" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             PlaceholderText="Optional — defaults to the executable's folder, else your home directory"
                             Text="{x:Bind ViewModel.WorkingDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1"
                            Content="Browse…"
                            Click="OnBrowseWorkingDirectoryClicked" />
                </Grid>
            </StackPanel>

            <!-- Shared parameters are edited on the CLI's "Shared parameters" screen
                 (reached from the CLI view header), not here. -->
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
